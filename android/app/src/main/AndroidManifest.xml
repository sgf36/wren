<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <!-- BILLING arrives from `in_app_purchase`, which pulls in
         com.android.billingclient:billing, and it is now wanted.
         Android sells the same unlock as iOS at the same price, so a
         BillingClient really is constructed here and the permission has to be
         present: a billing call without it fails at connection time, not at
         build, which is the kind of failure that reaches a user rather than a
         developer.

         This line used to carry tools:node="remove" and a comment explaining
         that Android sold nothing. It sells something now. Declared
         explicitly rather than left to the merge, so the intent is visible in
         the file a person reads — and CI asserts it survives into the merged
         manifest, because the app manifest saying something is not evidence
         that the bundle says it. -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Reading a screenshot happens on the phone: the text recogniser runs
         from a model inside the bundle and asks nothing of the network.
         Turning the name it read into a place does not. The system geocoder
         is what MapKit is on iPhone, and it answers over the network, so a
         place name does leave the device — exactly as the iOS build has
         always described.

         So INTERNET is genuinely required and stays. ACCESS_NETWORK_STATE is
         not: it arrives from the Google datatransport that the billing
         library depends on, for its own telemetry, and nothing here reads it.

         Wren still asks for no permission of its own beyond this one. There
         is no location permission, deliberately: the app never asks where the
         phone is, only where a place named in a screenshot is. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <application
        android:label="Wren"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Exports leave through a content:// URI, never a file path.
             A file:// URI grants the receiving app nothing: it launches, matches
             the MIME, tries to read and dies with EACCES. Measured against
             Organic Maps on 19 August 2026 — the intent was right and the
             transport was wrong, which is the confusing way round. -->
        <provider
            android:name=".PlaceFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <!-- Package visibility, Android 11 and later.
         Without an entry here, a package is invisible: getPackageInfo throws
         NameNotFoundException exactly as if the app were not installed, and a
         "Send to Organic Maps" button silently never appears on a phone that has
         it. Declared per package rather than with QUERY_ALL_PACKAGES, which is a
         restricted permission needing a Play declaration we have no grounds for.

         The intent query is what makes the plain chooser work for these types. -->
    <queries>
        <!-- Every package Wren offers as a named button, and nothing else.
             These must stay in step with `namedTargets` in lib/src/map_targets.dart:
             a target listed there but missing here is a button that never appears
             on a device that has the app, because getPackageInfo throws exactly as
             if it were not installed. -->
        <package android:name="app.organicmaps" />
        <!-- Not app.organicmaps.beta: the beta build type applies no
             applicationIdSuffix, so beta installs are still app.organicmaps. -->
        <package android:name="app.organicmaps.web" />
        <package android:name="net.osmand" />
        <package android:name="net.osmand.plus" />
        <package android:name="menion.android.locus" />
        <package android:name="com.trailbehind.android.gaiagps.pro" />
        <package android:name="cz.seznam.mapy" />
        <!-- Chrome, for the Google Maps route's Custom Tab. -->
        <package android:name="com.android.chrome" />
        <!-- Enumeration for the plain chooser, which serves every app nobody has
             tested. One action per <intent>, and path/pathPrefix/pathPattern are
             forbidden inside <queries> — so "anything ending in .gpx" cannot be
             expressed here, and detection is by package name and MIME only. -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="application/gpx+xml" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/gpx+xml" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
