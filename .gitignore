.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# --- this repository is PUBLIC ------------------------------------------------
# Credentials belong in GitHub Actions secrets (encrypted, not exposed to fork
# PRs) or in the Cloudflare Worker — never in a file here.
*.p8
*.p12
*.pem
*.key
*.keystore
*.jks
*.mobileprovision
.env
.env.*
!.env.example

# Personal reel screenshots: read them locally, do not publish them.
real/*
!real/README.md
screenshots/*
!screenshots/README.md

# Recorded advert footage. Regenerated by store/record.py or advert-footage.yml,
# and a few tens of megabytes per beat, so it is kept as a CI artifact rather
# than in the history.
footage/*
!footage/README.md
